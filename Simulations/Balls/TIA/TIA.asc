TEXT 1952 -176 Left 2 ;-1/(1-1/(2*(I(Vi1)*V(x2)-V(x1)*I(Vi2))+V(x1)+I(Vi2)))
TEXT 3288 -40 Left 2 !* --- Synthesize the loop gain onto a node ---\n \n*Blg loopgain 0 V = -1/(1-1/(2*(I(Vi1)*V(x2)-V(x1)*I(Vi2))+V(x1)+I(Vi2)))\n \n \n* --- Unity-gain crossover frequency (fc) ---\n \n.meas AC fc WHEN mag(-1/(1-1/(2*(I(Vi1)*V(x2)-V(x1)*I(Vi2))+V(x1)+I(Vi2))))=1 CROSS=1\n \n \n* --- Phase margin at fc ---\n \n.meas AC ph_at_fc FIND ph(-1/(1-1/(2*(I(Vi1)*V(x2)-V(x1)*I(Vi2))+V(x1)+I(Vi2)))) AT=fc\n \n.meas AC PM PARAM 180+ph_at_fc\n \n \n* --- Phase-crossover frequency (where phase hits -180) ---\n \n.meas AC fpc WHEN ph(-1/(1-1/(2*(I(Vi1)*V(x2)-V(x1)*I(Vi2))+V(x1)+I(Vi2))))=-180 CROSS=1\n \n \n* --- Gain margin at fpc, in dB ---\n \n.meas AC mag_at_fpc FIND mag(-1/(1-1/(2*(I(Vi1)*V(x2)-V(x1)*I(Vi2))+V(x1)+I(Vi2)))) AT=fpc\n \n.meas AC GM PARAM -20*log10(mag_at_fpc)\n \n \n* --- Aggregate across all .step points ---\n \n.meas fc_min   MIN fc\n \n.meas fc_max   MAX fc\n \n.meas fc_avg   AVG fc\n \n \n.meas PM_min   MIN PM\n \n.meas PM_max   MAX PM\n \n.meas PM_avg   AVG PM\n \n \n.meas GM_min   MIN GM\n \n.meas GM_max   MAX GM\n \n.meas GM_avg   AVG GM
